{
  "name": "@secorto/workspace",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "markdownlint-cli2": "^0.23.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm -r --if-present run dev",
    "start": "pnpm -r --if-present run start",
    "build": "pnpm -r --if-present run build",
    "preview": "pnpm -r --if-present run preview",
    "astro": "pnpm -r --if-present run astro",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "test:e2e:env": "pnpm -r --if-present run test:e2e:env",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:unit:watch": "pnpm -r --if-present run test:unit:watch",
    "test:unit:ui": "pnpm -r --if-present run test:unit:ui",
    "lint": "pnpm run lint:md && pnpm -r --if-present run lint",
    "lint:js": "pnpm -r --if-present run lint:js",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix"
  }
}

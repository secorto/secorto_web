{
  "name": "@secorto/web",
  "private": true,
  "type": "module",
  "version": "6.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit -- run && npm run test:e2e",
    "test:e2e": "npx playwright test",
    "test:e2e:env": "node --env-file=.env ./node_modules/@playwright/test/cli.js test",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:ui": "vitest --ui",
    "lint": "npm run lint:js",
    "lint:js": "eslint ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "astro-expressive-code": "0.44.1",
    "jsdom": "^30.0.1",
    "photoswipe": "^5.4.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@secorto/i18n-core": "workspace:*",
    "@secorto/astro-i18n": "workspace:*",
    "@secorto/step": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint-plugin-astro": "^3.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.3": true
  }
}

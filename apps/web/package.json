{
  "name": "@secorto/web",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "scripts": {
    "dev": "astro dev",
    "clean": "rimraf dist playwright-report test-results .astro",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit -- run && npm run test:e2e",
    "test:e2e": "npx playwright test",
    "test:e2e:env": "node --env-file=.env ./node_modules/@playwright/test/cli.js test",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:ui": "vitest --ui",
    "lint": "npm run lint:js",
    "lint:js": "eslint ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "astro": "7.3.8",
    "astro-expressive-code": "0.44.2",
    "astro-mermaid": "^2.1.0",
    "jsdom": "^30.1.2",
    "mermaid": "^12.1.0",
    "photoswipe": "^5.4.4",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@secorto/i18n": "workspace:*",
    "@secorto/step": "workspace:*",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.11.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.3": true
  }
}

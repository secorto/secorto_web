---
import { render, getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import Comments from '@components/Comments.astro'
import DetailContent from '@components/detail/DetailContent.astro'
import SEOHead from '@components/SEOHead.astro'
import LanguagePicker from '@components/LanguagePicker.astro'
import { useTranslations } from '@i18n/utils'
import { buildAllDetailPaths } from '@utils/staticPathsBuilder.adapters'
import { getSeoDescription } from '@domain/post'

export async function getStaticPaths() {
  return await buildAllDetailPaths(getCollection)
}

const { locale } = Astro.params
const { entry, links, config } = Astro.props

const t = useTranslations(locale)

const { Content } = await render(entry)
const pageDescription = getSeoDescription(entry.data)
---

<BaseLayout pageTitle={entry.data.title} description={pageDescription}>
  <SEOHead
    slot="seo-head"
    links={links}
    noindex={Boolean(entry.data.draft)}
  />
  <LanguagePicker slot="langpicker" links={links} />
  {entry.data.draft && (
    <div class="untranslated-notice" role="status">
      <p>{t('post.draft_notice')}</p>
    </div>
  )}

  <DetailContent
    section={config.name}
    locale={locale}
    entry={entry}
    Content={Content}
  />

  <Comments />
</BaseLayout>

---
import { render, getCollection } from 'astro:content'
import { createDetailTranslationLinks, getStaticPathsEntries } from '@secorto/i18n'
import BaseLayout from '@layouts/BaseLayout.astro'
import Comments from '@components/Comments.astro'
import DetailContent from '@components/detail/DetailContent.astro'
import EntrySEO from '@components/seo/EntrySEO.astro'
import { useTranslations } from '@i18n/utils'
import { getSeoDescription } from '@domain/post'
import { languages } from '@i18n/ui'
import { sectionRoutes } from '@domain/section'
import PreliminaryIcon from '@assets/img/preliminary.svg'

export async function getStaticPaths() {
  return await getStaticPathsEntries(sectionRoutes, getCollection, languages)
}

export type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props']
export type Params = Awaited<ReturnType<typeof getStaticPaths>>[number]['params']

const { locale } = Astro.params
const { entry, siblings, section } = Astro.props

const links = createDetailTranslationLinks(siblings, sectionRoutes, languages)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const t = useTranslations(locale)

const { Content } = await render(entry.original)
const pageDescription = getSeoDescription(entry.original.data)
---

<BaseLayout pageTitle={entry.original.data.title} description={pageDescription} links={links}>
  <EntrySEO
    slot="seo-head"
    title={entry.original.data.title}
    description={pageDescription}
    url={canonicalURL.toString()}
    links={links}
    image={entry.original.data.image}
    section={section}
    noindex={entry.draft}
  />
  {entry.draft && (
    <div class="untranslated-notice" role="status">
      <p><PreliminaryIcon aria-hidden="true" /> {t('post.draft_notice')}</p>
    </div>
  )}

  <DetailContent
    section={section}
    locale={locale}
    entry={entry.original}
    Content={Content}
  />

  <Comments />
</BaseLayout>

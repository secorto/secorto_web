---
import BaseLayout from '@layouts/BaseLayout.astro'
import SEOHead from '@components/SEOHead.astro'
import Tags from '@components/Tags.astro'
import LanguagePicker from '@components/LanguagePicker.astro'
import ListContent from '@components/list/ListContent.astro'
import { useTranslations } from '@i18n/utils'
import { buildTagPaths } from '@utils/staticPathsBuilder.adapters'
import type { TagPath } from '@utils/staticPathsBuilder'
import { filterByLocale, getUniqueTags } from '@utils/paths'

export async function getStaticPaths() {
  return await buildTagPaths()
}

export type Props = TagPath['props']
export type Params = TagPath['params']

const { locale, tag } = Astro.params
const { allEntries, config, links } = Astro.props
const t = useTranslations(locale)

const localePosts = filterByLocale(allEntries, locale)
const posts = localePosts.filter((post) => post.data.tags?.includes(tag))
const tags = getUniqueTags(localePosts)
const pageTitle = `${t(config.translationKey)} - ${tag}`
const metaDescription = `${config.taggedKey ? t(config.taggedKey) : t(config.translationKey)} ${tag}`
---

<BaseLayout pageTitle={pageTitle} description={metaDescription}>
  <SEOHead slot="seo-head" links={links} />
  <LanguagePicker slot="langpicker" links={links} />
  <Tags locale={locale} section={config.name} tags={tags} current={tag} />
  {config.taggedKey && <p>{t(config.taggedKey)} {tag}</p>}

  {posts.length === 0 ? (
    <div class="warning">
      <p>{t('tags.untranslated_notice')}</p>
    </div>
  ) : (
    <div>
      <ListContent section={config.name} posts={posts} cta={t(config.ctaKey)} locale={locale} />
    </div>
  )}
</BaseLayout>

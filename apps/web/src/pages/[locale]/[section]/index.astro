---
import BaseLayout from '@layouts/BaseLayout.astro'
import SEOHead from '@components/SEOHead.astro'
import Tags from '@components/Tags.astro'
import LanguagePicker from '@components/LanguagePicker.astro'
import { useTranslations } from '@i18n/utils'
import { filterByLocale, getUniqueTags, mapEntryId } from '@utils/paths'
import ListContent from '@components/list/ListContent.astro'
import { buildSectionIndexPaths } from '@utils/staticPathsBuilder.adapters'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  return await buildSectionIndexPaths()
}

const { locale, section } = Astro.params
const sectionProps = Astro.props
const config = sectionProps.config
const links = sectionProps.links
const t = useTranslations(locale)
const pageTitle = t(config.translationKey)
const rawPosts = filterByLocale(await getCollection(config.name), locale)
const tags = getUniqueTags(rawPosts)
const posts = mapEntryId(rawPosts)
---

<BaseLayout pageTitle={pageTitle}>
  <SEOHead slot="seo-head" links={links} />
  <LanguagePicker slot="langpicker" links={links} />
  {tags.length > 0 && (
    <Tags route={`/${locale}/${section}/tags/`} tags={tags} />
  )}
  <ListContent section={sectionProps.config.name} posts={posts} lang={locale} cta={t(config.ctaKey)} />
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro'
import PageSEO from '@components/seo/PageSEO.astro'
import Tags from '@components/Tags.astro'
import ListContent from '@components/list/ListContent.astro'
import { getCollection } from 'astro:content'
import { availableLink, getStaticPathsSections, availableAtLocale } from '@secorto/i18n'
import { languages, sections } from '@i18n/ui'
import { sectionRoutes } from '@domain/section'
import { tagRoutes } from '@domain/tags'

export async function getStaticPaths() {
  return await getStaticPathsSections(sectionRoutes, languages)
}

export type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props']
export type Params = Awaited<ReturnType<typeof getStaticPaths>>[number]['params']

const { locale } = Astro.params
const { section } = Astro.props
const title = sections[section][locale]
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const pageDescription = `Explora ${title.toLowerCase()}`
const posts = await getCollection(section, availableAtLocale(locale))
const links = languages.all.map(lang => availableLink(sectionRoutes.getSectionPath(section, lang), lang))
const tags = tagRoutes.getTags()
  .filter(tag =>
    posts.some(post => post.data.tags.includes(tag)),
  )
---

<BaseLayout title={title} links={links}>
  <PageSEO
    slot="seo-head"
    title={title}
    description={pageDescription}
    url={canonicalURL.toString()}
    links={links}
  />
  <Tags locale={locale} section={section} tags={tags} />
  <ListContent section={section} posts={posts} locale={locale} />
</BaseLayout>

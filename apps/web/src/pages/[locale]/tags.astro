---
import BaseLayout from '@layouts/BaseLayout.astro'
import SEOHead from '@components/SEOHead.astro'

import { languages, sections } from '@i18n/ui'
import { useTranslations } from '@i18n/utils'

import { availableLink, getStaticPathsLocales } from '@secorto/i18n'

import { sectionRoutes } from '@domain/section'
import { tagRoutes } from '@domain/tags'

import { getEntriesBySection, getSectionsWithTagContent, availableAtLocale } from '@secorto/i18n'
import { getCollection } from 'astro:content'

export function getStaticPaths() {
  return getStaticPathsLocales(languages)
}

export type Params =
  Awaited<ReturnType<typeof getStaticPaths>>[number]['params']

const { locale } = Astro.params

const t = useTranslations(locale)

const pageTitle = t('tags.index_title')

const links = languages.all.map(lang =>
  availableLink(tagRoutes.getTagIndexPath(lang), lang)
)

const sectionEntries = await getEntriesBySection(
  sectionRoutes,
  section => getCollection(section, availableAtLocale(locale)),
)

const tagsWithSections = tagRoutes.getTags().map(tag => ({
  tag,
  sections: getSectionsWithTagContent(
    sectionRoutes,
    sectionEntries,
    tag,
    (entry, currentTag) =>
      entry.data.tags?.includes(currentTag) ?? false,
  ),
})).filter(({ sections }) => sections.length > 0)
---

<BaseLayout
  pageTitle={pageTitle}
  description={t('tags.index_description')}
  links={links}
>
  <SEOHead slot="seo-head" links={links} />

  <section class="tags-section-wrapper">
    <p class="tags-intro-description" data-testid="tags-description">
      {t('tags.index_description')}
    </p>

    <ul class="tag-groups" data-testid="global-tag-groups">
      {tagsWithSections.map(({ tag, sections: availableSections }) => (
        <li
          class="tag-static-card"
          data-testid={`global-tag-${tag}`}
        >
          <div class="tag-card-header">
            <svg xmlns="http://w3.org" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tag-card-icon"><path d="M12 2H2v10l9.29 9.29c.39.39 1.02.39 1.41 0l8.59-8.59c.39-.39.39-1.02 0-1.41L12 2z"></path><path d="m7 7-.01.01"></path></svg>
            <h2>{tagRoutes.getTagSlug(tag, locale)}</h2>
          </div>

          <div class="tag-card-body">
            <span class="available-label">{t('tags.available_in')}:</span>
            <div class="sections-pills-container">
              {availableSections.map(({ section, count }) => (
                <a
                  href={tagRoutes.getSectionTagPath(section, locale, tag)}
                  class="section-pill"
                >
                  <span class="pill-name">{sections[section][locale]}</span>
                  <span class="pill-count">{count}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* --- Estructura y Caja de Respiración de la Página --- */
  .tags-section-wrapper {
    width: 100%;
    max-width: 80ch; /* Limita el ancho del texto para una lectura óptima */
    margin: 0 auto;
  }

  .tags-main-title {
    color: var(--colors-heading);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .tags-intro-description {
    color: var(--colors-text);
    font-size: 1.1rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* --- Rejilla de Tarjetas Estáticas --- */
  .tag-groups {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); /* Rejilla responsive automática */
    gap: 1.5rem;
  }

  /*
    TARJETA ESTÁTICA PREMIUM:
    Reutiliza milimétricamente la estética tridimensional de tu baseline de cards
    pero adaptada a un contenedor no-cliqueable.
  */
  .tag-static-card {
    box-sizing: border-box;
    background: var(--colors-background);
    border: 1px solid var(--colors-border-lazy);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    /* Sombra suave e idéntica a tu baseline en modo claro */
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04),
                0 2px 4px -1px rgba(0, 0, 0, 0.01);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Cabecera interna de la Tarjeta */
  .tag-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--colors-primary);
  }

  .tag-card-icon {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .tag-static-card h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--colors-heading);
    text-transform: capitalize; /* Asegura un look pulido en los títulos */
  }

  /* Cuerpo interno de la Tarjeta */
  .tag-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .available-label {
    font-size: 0.85rem;
    color: var(--colors-muted);
    font-weight: 500;
  }

  /* --- Contenedor de Píldoras de las Secciones (Blog / Charlas) --- */
  .sections-pills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-pill {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-family: "Ubuntu", sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--colors-border-lazy);
    border-radius: 2rem;
    overflow: hidden; /* Mantiene el look encapsulado */
    transition: all 0.2s ease-in-out;
  }

  /* Nombre de la sección (Fondo limpio hereda el entorno) */
  .pill-name {
    padding: 0.3rem 0.6rem;
    color: var(--colors-primary);
    background-color: transparent;
  }

  /* Contador numérico embutido a la derecha */
  .pill-count {
    padding: 0.3rem 0.5rem;
    color: var(--colors-background); /* Blanco en modo claro, oscuro en modo negro */
    background-color: var(--colors-primary); /* Relleno con tu color de marca */
    font-weight: 600;
  }

  /* --- MICRO-INTERACCIONES EN HOVER --- */
  .section-pill:hover {
    border-color: var(--colors-hover);
  }

  .section-pill:hover .pill-name {
    color: var(--colors-hover);
    background-color: rgba(var(--colors-hover-rgb), 0.05);
  }

  .section-pill:hover .pill-count {
    background-color: var(--colors-hover);
  }

  /* ========================================================
     MODO OSCURO INTEGRADO CON TU CLASE .dark GLOBAL
     ======================================================== */
  :global(.dark) .tag-static-card {
    background: var(--colors-blogBg); /* Usa tu fondo alternativo oscuro */
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.4);
  }

  :global(.dark) .tag-static-card:hover {
    transform: translateY(-2px); /* Un sutil levantamiento táctico al pasar el mouse por la tarjeta */
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.5);
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro'
import SEOHead from '@components/SEOHead.astro'
import LanguagePicker from '@components/LanguagePicker.astro'
import { languages, sections } from '@i18n/ui'
import { useTranslations } from '@i18n/utils'
import { buildGlobalTagGroups, type TagGroup, type TagGroupSectionInput } from '@domain/tags'
import { availableLink, getStaticPathsLocales } from '@secorto/i18n'
import { sectionKeys, sectionRoutes } from '@domain/section'
import { getCollection } from 'astro:content'
import { availableAtLocale } from '@secorto/i18n'

export function getStaticPaths() {
  return getStaticPathsLocales(languages)
}

export type Params = Awaited<ReturnType<typeof getStaticPaths>>[number]['params']

const { locale } = Astro.params
const t = useTranslations(locale)
const pageTitle = t('tags.index_title')

const links = languages.all.map(locale => availableLink(`/${locale}/tags`, locale))

// Construir sectionInputs a partir de datos cacheados (sin fetch)
const sectionInputs: TagGroupSectionInput[] = []

for (const section of sectionKeys) {
  const localeEntries = await getCollection(section, availableAtLocale(locale))

  sectionInputs.push({
    section: section,
    sectionLabel: sections[section][locale],
    entries: localeEntries
  })
}

const tagGroups: TagGroup[] = buildGlobalTagGroups(locale, sectionInputs)
---

<BaseLayout pageTitle={pageTitle} description={t('tags.index_description')}>
  <SEOHead slot="seo-head" links={links} />
  <LanguagePicker slot="langpicker" links={links} />

  <section>
    <p data-testid="tags-description">{t('tags.index_description')}</p>

    {tagGroups.length === 0 ? (
      <p>{t('tags.index_no_tags')}</p>
    ) : (
      <ul class="tag-groups" data-testid="global-tag-groups">
        {tagGroups.map((group) => (
          <li class="tag-group" data-testid={`global-tag-${group.canonicalTag}`}>
            <h2>{group.localizedTag}</h2>
            <p>
              {t('tags.available_in')}:
              {group.references.map((reference, index) => (
                <Fragment>
                  {index > 0 && ' / '}
                  <a href={sectionRoutes.getEntryTagURL(reference.section, locale, reference.tagSlug)}>
                    {sections[reference.section][locale]}
                  </a>
                </Fragment>
              ))}
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .tag-groups {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .tag-group {
    border: dotted 2px var(--colors-primary);
    border-radius: .5em;
    padding: 1rem;
  }

  .tag-group h2 {
    margin: 0 0 .5rem;
  }
</style>

---
import Card from '@components/ui/Card.astro'
import { useTranslations } from '@i18n/utils'
import { formatString } from '@utils/formatString'
import { Image } from 'astro:assets'
import { type UILanguages } from '@i18n/ui'

interface Props {
  title: string
  path: string
  image?: ImageMetadata
  excerpt?: string
  cta: string
  locale: UILanguages
}

const { title, path, image, excerpt = '', cta, locale } = Astro.props
const t = useTranslations(locale)
---

<Card path={path} testId='list-items'>
  {image &&
    <Image src={image} alt={formatString(t('featured_image'), [title])} class="card-image" />
  }
  <div class="card-content">
    <h2 class="card-title">{title}</h2>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
    <div class="card-details">
      <slot/>
    </div>
    <div class="card-cta">
      {cta}
    </div>
  </div>
</Card>

<style>
  /* ÚNICAMENTE estilos de composición interna de datos para listados */
  .card-content {
    box-sizing: border-box;
    margin: 0px;
    color: var(--colors-primary);
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-title {
    margin: 0;
    font-size: 1.4rem;
    color: var(--colors-heading);
  }

  .card-excerpt {
    margin: 0;
    color: var(--colors-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .card-details {
    color: var(--colors-text);
  }

  .card-image {
    flex-shrink: 0;
    width: 21rem;
    height: 12rem;
    object-fit: contain;
    border-radius: 8px;
    display: block;
  }

  .card-cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--colors-primary);
    transition: color 0.2s ease;
  }

  /* Ajustes específicos internos si la pantalla se vuelve pequeña */
  @container (max-width: 829px) {
    .card-content {
      text-align: center;
      width: 100%;
    }
    .card-image {
      width: 100%;
      height: auto;
      max-height: 14rem;
    }
  }
</style>

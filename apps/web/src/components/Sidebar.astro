---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../i18n/utils'
import { navSections, sectionRoutes } from '@domain/section'
import { languages, sections } from '@i18n/ui'
import { standalonePageRoutes } from '@domain/standalonePage'
import Photo from '@assets/img/sergio-orozco.jpeg'
import { Image } from 'astro:assets'


import ThemeIcon from './ThemeIcon.astro'
import LanguagePicker from './LanguagePicker.astro'
import type { TranslationLink } from '@domain/translationLink'

export interface Props {
  links: TranslationLink[]
}

const { links } = Astro.props
const currentLocale = languages.fromString(Astro.currentLocale)
const t = useTranslations(currentLocale)

// 1. Capturamos la ruta limpia actual para las comparaciones dinámicas
const currentPath = Astro.url.pathname

// 2. Precalculamos los paths de control para limpiar el marcado inferior
const homePath = getRelativeLocaleUrl(currentLocale, '/')
const aboutPath = standalonePageRoutes.getPagePath('about', currentLocale)

// 3. Función validadora sin puntos y comas
const isSectionActive = (targetUrl: string, isHome = false) => {
  if (isHome) return currentPath === targetUrl || currentPath === `${targetUrl}/`
  return currentPath.startsWith(targetUrl)
}
---

<nav class="sidebar sidebar-toggle">
  <div class="sidebar-content">
    <div>
      <a
        class="sidebar-home-link"
        href={homePath}
        {...isSectionActive(homePath, true) && { 'aria-current': 'page' }}
      >
        <div class="sidebar-image">
          <Image src={Photo} alt={t('sidebar.photo_alt')} width="256" height="256" data-testid="sidebar-photo" />
        </div>
        <p class="sidebar-title" data-testid="sidebar-title">Sergio Carlos Orozco Torres</p>
      </a>
      <hr class="sidebar-separator">
    </div>
    <div class="sidebar-links" data-testid="sidebar-links">
      <a
        href={aboutPath}
        {...isSectionActive(aboutPath) && { 'aria-current': 'page' }}
        data-testid="sidebar-about"
      >
        {t('nav.about')}
      </a>
      {navSections.map((section) => {
        const sectionPath = sectionRoutes.getSectionPath(section, currentLocale)
        return (
          <a
            href={sectionPath}
            {...isSectionActive(sectionPath) && { 'aria-current': 'page' }}
            data-testid={`sidebar-${section}`}
          >
            {sections[section][currentLocale]}
          </a>
        )
      })}
    </div>
    <ThemeIcon />
    <LanguagePicker links={links} />
  </div>
</nav>

---
import type { TranslationLink } from '@domain/translationLink'
import { isAvailable, isDraft, isMissing } from '@domain/translationLink'
import AvailableLink from './lang-picker/AvailableLink.astro'
import DraftLink from './lang-picker/DraftLink.astro'
import MissingLink from './lang-picker/MissingLink.astro'

interface Props {
  links: TranslationLink[]
}

const { links } = Astro.props
---

<div class="language-picker">
  {links.map((item) => {
    if (isAvailable(item)) return <AvailableLink item={item} />
    if (isDraft(item)) return <DraftLink item={item} />
    if (isMissing(item)) return <MissingLink item={item} />
    throw new Error(`TranslationLink type not recognized`)
  })}
</div>

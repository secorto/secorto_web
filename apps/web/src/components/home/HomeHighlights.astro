---
import HomeHighlightItem from './HomeHighlightItem.astro'
import type { SectionType } from '@domain/section'
import type { UILanguages } from '@i18n/ui'

interface Props {
  highlights: { slug: string, section: SectionType }[]
  locale: UILanguages
}

const { highlights, locale } = Astro.props
---

<div class="highlights">
  <div class="highlights-cards">
    {highlights.map(({ slug, section }) => (
      <HomeHighlightItem slug={slug} section={section} locale={locale} />
    ))}
  </div>
</div>

<style>
  /* Este CSS ya lo tienes en tu home.css externo,
     puedes dejar este bloque vacío o removerlo si se lee desde allá */
  .highlights {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .highlights-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
</style>

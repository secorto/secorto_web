---
// src/components/home/HomeHighlightItem.astro
import Card from '@components/ui/Card.astro'
import { sectionRoutes, type SectionType } from '@domain/section'
import { cta, sections, type UILanguages } from '@i18n/ui'
import { getEntry } from 'astro:content'

interface Props {
  slug: string,
  section: SectionType,
  locale: UILanguages
}

const { slug, section, locale } = Astro.props
const entry = await getEntry(section, `${locale}/${slug}`)

if (!entry) {
  throw new Error(`[FAIL-FAST] No se pudo renderizar el destacado para el slug "${slug}" en la sección "${section}"`);
}
---

<Card path={sectionRoutes.getEntryPath(section, locale, slug)}>
  <div class="card-content">
    <span class="highlight-label">{sections[section][locale]}</span>
    <h3 class="card-title">{entry.data.title}</h3>
    {entry.data.excerpt && <p class="card-excerpt">{entry.data.excerpt}</p>}
    <div class="card-cta">
      {cta[section][locale]}
    </div>
  </div>
</Card>

<style>
  /* Estilos específicos de composición interna de datos */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    height: 100%;

  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--colors-heading);
    line-height: 1.3;
  }

  .card-excerpt {
    margin: 0;
    color: var(--colors-text);
    font-size: 0.95rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--colors-primary);
    transition: color 0.2s ease;
  }

  @container (max-width: 829px) {
    .card-content {
      text-align: center;
    }
  }
</style>

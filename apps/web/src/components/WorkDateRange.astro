---
import { useTranslations } from '@i18n/utils'
import type { UILanguages } from '@i18n/ui'
import { formatDateRange } from '@domain/post'
import { monthYear } from '@i18n/dateFormat'

interface Props {
  locale: UILanguages
  startDate?: Date
  endDate?: Date
  /**
   * Si true, muestra las fechas con labels (dt/dd) en lugar de rango simple
   * @default false
   */
  showLabels?: boolean
}

const { locale, startDate, endDate, showLabels = false } = Astro.props
const t = useTranslations(locale)
const dateFormat = new Intl.DateTimeFormat(locale, monthYear)

const rangeText = formatDateRange(startDate, endDate, (d) => dateFormat.format(d), t('work.today'))
---

{rangeText && (showLabels ? (
  <>
    <dt>{t('post.work_period')}</dt>
    <dd>{rangeText}</dd>
  </>
) : (
  <span>{rangeText}</span>
))}

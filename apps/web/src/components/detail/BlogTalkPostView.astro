---
import { Image } from 'astro:assets'
import Gallery from '@components/Gallery.astro'
import { useTranslations } from '@i18n/utils'
import type { UILanguages } from '@i18n/ui'
import ResponsiveIframe from '@components/ResponsiveIframe.astro'
import type { RenderResult } from 'astro:content'
import PostDate from '@components/PostDate.astro'
import { full } from '@i18n/dateFormat'

interface Props {
  locale: UILanguages
  entry: {
    data: {
      title: string
      date?: Date
      tags: string[]
      image?: string | ImageMetadata
      excerpt?: string
      gallery?: Array<{ image: ImageMetadata; alt: string }>
      video? : string,
      slide? : string
    }
  }
  Content: RenderResult['Content']
}

const { locale, entry, Content } = Astro.props
const t = useTranslations(locale)
const dateFormat = new Intl.DateTimeFormat(locale, full)
---

{entry.data.video &&
    <ResponsiveIframe
      width="100%"
      height="600"
      src={entry.data.video}
      frameBorder="0"
      allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
      allowFullScreen
      title={`${t('post.video')} ${entry.data.title}`}
      data-testid="post-video"
    />
}

{entry.data.image && !entry.data.video && (
  typeof entry.data.image === 'string' ? (
    <img src={entry.data.image} alt="featured image" />
  ) : (
    <Image src={entry.data.image} alt="featured image" />
  )
)}

{entry.data.date && <PostDate>{dateFormat.format(entry.data.date)}</PostDate>}

{entry.data?.excerpt && (
  <p><em>{entry.data.excerpt}</em></p>
)}

<Content />

{entry.data.slide &&
    <ResponsiveIframe
      src={entry.data.slide}
      width="100%"
      height="600"
      frameBorder="0"
      title={`Presentación de la charla ${entry.data.title}`}
      data-testid="post-slide"
    />
}

{entry.data.gallery && (
  <Gallery items={entry.data.gallery}/>
)}

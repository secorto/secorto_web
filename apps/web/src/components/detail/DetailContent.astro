---
import type { UILanguages } from '@i18n/ui'
import BlogTalkPostView from './BlogTalkPostView.astro'
import WorkProjectCommunityView from './WorkProjectCommunityView.astro'
import Tags from '@components/Tags.astro'
import type { SectionType } from '@domain/section'
import type { RenderResult } from 'astro:content'
import type { PostEntry } from '@domain/post'

const detailComponentMap = {
  blog: BlogTalkPostView,
  talk: BlogTalkPostView,
  work: WorkProjectCommunityView,
  projects: WorkProjectCommunityView,
  community: WorkProjectCommunityView
} as const satisfies Record<SectionType, typeof BlogTalkPostView | typeof WorkProjectCommunityView>

interface Props {
  section: SectionType
  locale: UILanguages
  entry: PostEntry<SectionType>
  Content: RenderResult['Content']
}

const { locale, entry, Content, section } = Astro.props
const DetailComponent = detailComponentMap[section]
---

<Tags section={section} locale={locale} tags={entry.data.tags} />

<DetailComponent
  locale={locale}
  entry={entry}
  Content={Content}
/>

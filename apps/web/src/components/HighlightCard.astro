---
import { sectionRoutes, type SectionType } from '@domain/section'
import { cta, sections, type UILanguages } from '@i18n/ui'
import { getEntry } from 'astro:content'

interface Props {
  slug: string,
  section: SectionType,
  locale: UILanguages
}

const { slug, section, locale } = Astro.props
const entry = await getEntry(section, `${locale}/${slug}`)

if(!entry) {
  throw new Error(`Cannot render highlight for entry ${slug} with section ${section} and locale ${locale}`)
}
---

<a class="highlight-card" href={sectionRoutes.getEntryPath(section, locale, slug)}>
  <span class="highlight-label">{sections[section][locale]}</span>
  <h2 class="highlight-title">{entry.data.title}</h2>
  {entry.data.excerpt && <p class="highlight-excerpt">{entry.data.excerpt}</p>}
  <span class="highlight-cta">{cta[section][locale]}</span>
</a>

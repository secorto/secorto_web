---
/**
 * Componente unificado para metadatos SEO.
 * Recibe rutas relativas y normaliza a URLs absolutas usando `import.meta.env.SITE`.
 */
import { isAccessible } from '@domain/translationLink'
import type { TranslationLink } from '@domain/translationLink'
import { resolveDefaultAccessibleLink } from '@secorto/i18n'
import { defaultLang } from '@i18n/ui'

interface Props {
  links: TranslationLink[]
  /** Marcar como noindex cuando aplique */
  noindex?: boolean
}

const { links, noindex = false } = Astro.props
const site = import.meta.env.SITE

const alternates = links.filter(isAccessible)
const defaultLink = resolveDefaultAccessibleLink(links, defaultLang)
---
{noindex && <meta name="robots" content="noindex" />}
<link rel="alternate" hreflang="x-default" href={`${site}${defaultLink.href}`} />

{alternates.map(({ locale, href }) => (
  <link rel="alternate" hreflang={locale} href={`${site}${href}`} />
))}

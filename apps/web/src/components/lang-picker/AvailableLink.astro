---
import { languagesMap, type UILanguages } from '@i18n/ui'
import type { AvailableLink } from '@domain/translationLink'

interface Props {
  item: AvailableLink<UILanguages>
}

const { item } = Astro.props
const text = languagesMap[item.locale]
const isCurrentLocale = Astro.currentLocale === item.locale
---

<a
  href={item.href}
  aria-label={text}
  {...isCurrentLocale && { 'aria-current': 'page' }}
  data-testid={`lang-${item.locale}`}
  class:list={['lang-link', { 'is-active': isCurrentLocale }]}
>
  {text}
</a>

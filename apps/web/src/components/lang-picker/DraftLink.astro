---
import type { DraftLink } from '@domain/translationLink'
import { languagesMap, ui, type UILanguages } from '@i18n/ui'
import PreliminaryIcon from '@assets/img/preliminary.svg'

interface Props {
  item: DraftLink<UILanguages>
}

const { item } = Astro.props
const label = languagesMap[item.locale]
const title = ui[item.locale]['translation.disabled.draft']
const isCurrentLocale = Astro.currentLocale === item.locale
---

<a
  href={item.href}
  aria-label={`${title}: ${label}`}
  title={title}
  data-testid={`lang-${item.locale}`}
  class:list={['lang-link', { 'is-active': isCurrentLocale }]}
  {...isCurrentLocale && { 'aria-current': 'page' }}
>
  {label} <PreliminaryIcon />
</a>

---
import PostItem from '@components/PostItem.astro'
import PostList from '@components/PostList.astro'
import PostDate from '@components/PostDate.astro'
import WorkDateRange from '@components/WorkDateRange.astro'
import type { ExperienceLikeEntry } from '@domain/post'
import type { UILanguages } from '@i18n/ui'
import { sortExperienceByPriority } from '@utils/sorting'
import { getEntryURL, type SectionType } from '@domain/section'

export interface Props {
  section: SectionType
  posts: ExperienceLikeEntry[]
  lang: UILanguages
  cta: string
}

const { posts, lang, cta, section } = Astro.props
---

<PostList>
  {sortExperienceByPriority(posts).map((post) =>
    <PostItem
      image={post.data.image}
      url={getEntryURL(section, lang, post.cleanId)}
      title={post.data.title}
      cta={cta}
    >
      {post.data.startDate && (
        <PostDate>
          <WorkDateRange
            locale={lang}
            startDate={post.data.startDate}
            endDate={post.data.endDate}
          />
        </PostDate>
      )}
      <p data-testid="post-role">{post.data.role}</p>
      <p data-testid="post-responsibilities">{post.data.responsibilities}</p>
    </PostItem>
  )}
</PostList>

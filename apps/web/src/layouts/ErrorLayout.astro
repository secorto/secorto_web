---
import type { MarkdownLayoutProps } from 'astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import ErrorSEO from '@components/seo/ErrorSEO.astro'
import { missingLink } from '@secorto/i18n'
import { getLocale, languages } from '@i18n/ui'

type Props = MarkdownLayoutProps<{
  title: string
}>

const { frontmatter } = Astro.props
const { title } = frontmatter

const locale = getLocale(Astro.currentLocale)
const links = languages.all.map(l => missingLink(l))
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const description =
  locale === 'en'
    ? 'The page you are looking for does not exist or is not available at the moment.'
    : 'La página que buscas no existe o no está disponible en este momento.'
---

<BaseLayout title={title} links={links}>
  <ErrorSEO
    slot="seo-head"
    title={title}
    description={description}
    url={canonicalURL.toString()}
  />
  <slot/>
</BaseLayout>

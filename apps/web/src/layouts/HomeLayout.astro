---
import type { MarkdownLayoutProps } from 'astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import SEOHead from '@components/SEOHead.astro'
import RelatedContent from '@components/related/RelatedContent.astro'

import intro from '@assets/img/intro.inline.svg?raw'
import { availableLink } from '@domain/translationLink'
import { languages } from '@i18n/ui'
import { HomeFrontmatterSchema, type HomeFrontmatter } from '@domain/home'

type Props = MarkdownLayoutProps<HomeFrontmatter>

const { frontmatter } = Astro.props
const parsed = HomeFrontmatterSchema.parse(frontmatter)

const { title, subTitle, locale, relatedContent, draft } = parsed

const links = languages.all.map(lang =>
  availableLink(`${languages.getPath(lang)}/`, lang)
)

import '../styles/home.css'
---

<BaseLayout pageTitle={title} links={links}>
  <SEOHead slot="seo-head" links={links} noindex={Boolean(draft)} />

  <section class="home-bio">
    <div class="home-avatar" set:html={intro} />
    <div class="home-bio-text">
      <h2 class="home-bio-subtitle">{subTitle}</h2>
      <div class="home-bio-content">
        <slot />
      </div>
    </div>
  </section>

  <RelatedContent relatedContent={relatedContent} locale={locale} />
</BaseLayout>

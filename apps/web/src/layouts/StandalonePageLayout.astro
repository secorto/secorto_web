---
import type { MarkdownLayoutProps } from 'astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { createStandalonePageLinks } from '@secorto/i18n'
import PageSEO from '@components/seo/PageSEO.astro'
import { languages } from '@i18n/ui'
import { standalonePageRoutes } from '@domain/standalonePage'
import { useTranslations } from '@i18n/utils'
import PreliminaryIcon from '@assets/img/preliminary.svg'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  translationKey: string
}>

const { frontmatter } = Astro.props
const { title, description, translationKey } = frontmatter
const path = Astro.url.pathname.slice(1).replace(/\/$/, '')

const links = createStandalonePageLinks(
  path,
  translationKey,
  standalonePageRoutes,
  languages,
)
const locale = languages.fromString(Astro.currentLocale)
const page = standalonePageRoutes.getPage(translationKey)
const draft = standalonePageRoutes.routes[page][locale]?.draft ?? false
const t = useTranslations(locale)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<BaseLayout pageTitle={title} links={links}>
  <PageSEO
    slot="seo-head"
    title={title}
    description={description}
    url={canonicalURL.toString()}
    links={links}
    noindex={Boolean(draft)}
  />
  {draft && (
    <div class="untranslated-notice" role="status">
      <p><PreliminaryIcon aria-hidden="true" /> {t('page.draft_notice')}</p>
    </div>
  )}

  <slot/>
</BaseLayout>

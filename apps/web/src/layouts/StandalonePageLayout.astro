---
import type { MarkdownLayoutProps } from 'astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { createStandalonePageLinks } from '@secorto/i18n'
import SEOHead from '@components/SEOHead.astro'
import { languages } from '@i18n/ui'
import { standalonePageRoutes } from '@domain/standalonePage'

type Props = MarkdownLayoutProps<{
  title: string
  draft?: boolean
  translationKey: string
}>

const { frontmatter } = Astro.props
const { title, draft, translationKey } = frontmatter
const path = Astro.url.pathname.slice(1).replace(/\/$/, '')

const links = createStandalonePageLinks(
  path,
  translationKey,
  standalonePageRoutes,
  languages,
)
---

<BaseLayout pageTitle={title} links={links}>
  <SEOHead
    slot="seo-head"
    links={links}
    noindex={Boolean(draft)}
  />
  <slot/>
</BaseLayout>

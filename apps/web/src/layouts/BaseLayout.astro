---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import SiteLayout from './SiteLayout.astro';
import type { TranslationLink } from '@domain/translationLink'

interface Props {
  pageTitle: string
  description?: string
  links: TranslationLink[]
}

const { pageTitle, description, links } = Astro.props
---
<SiteLayout pageTitle={pageTitle} description={description} links={links}>
  <slot name="seo-head" slot="seo-head" />
  <Header title={pageTitle} />
  <main class="main-content">
    <slot />
  </main>
  <Footer />
</SiteLayout>

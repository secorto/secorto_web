---
import type { MarkdownLayoutProps } from 'astro'
import BaseLayout from "@layouts/BaseLayout.astro"
import SEOHead from '@components/SEOHead.astro'
import LanguagePicker from '@components/LanguagePicker.astro'
import HomeHighlights from '@components/HomeHighlights.astro'

import intro from '@assets/img/intro.inline.svg?raw'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '@i18n/utils'
import { getPostsByLocale } from '@utils/paths'
import { sectionsConfig } from '@domain/section'
import type { UILanguages } from '@i18n/ui'

type Props = MarkdownLayoutProps<{
  title: string
  subTitle: string
  locale: UILanguages
  pybaqUrl: string
  draft?: boolean
}>

const { frontmatter } = Astro.props
const { title, subTitle, locale, pybaqUrl, draft } = frontmatter

const links = buildHomeLinks()
const t = useTranslations(locale)

const [blogPosts, talkPosts] = await Promise.all([
  getPostsByLocale('blog', locale),
  getPostsByLocale('talk', locale),
])

const latestBlog = blogPosts[0]
const latestTalk = talkPosts[0]

const blogRoute = sectionsConfig.blog.routes[locale]
const talkRoute = sectionsConfig.talk.routes[locale]

import '../styles/home.css'
import { buildHomeLinks } from '@i18n/languagePickerUtils'

---

<BaseLayout pageTitle={title}>
  <LanguagePicker slot="langpicker" links={links} />
  <SEOHead slot="seo-head" links={links} noindex={Boolean(draft)} />

  <section class="home-bio">
    <div class="home-avatar" set:html={intro} />
    <div class="home-bio-text">
      <h2 class="home-bio-subtitle">{subTitle}</h2>
      <div class="home-bio-content">
        <slot />
      </div>
    </div>
  </section>

  <HomeHighlights
    blog={{
      sectionLabel: t(sectionsConfig.blog.translationKey),
      title: latestBlog.data.title,
      excerpt: latestBlog.data.excerpt ?? '',
      url: getRelativeLocaleUrl(locale, `${blogRoute}/${latestBlog.cleanId}`),
      cta: t(sectionsConfig.blog.ctaKey)
    }}
    talk={{
      sectionLabel: t(sectionsConfig.talk.translationKey),
      title: latestTalk.data.title,
      excerpt: latestTalk.data.excerpt ?? '',
      url: getRelativeLocaleUrl(locale, `${talkRoute}/${latestTalk.cleanId}`),
      cta: t(sectionsConfig.talk.ctaKey)
    }}
    pybaq={{
      label: t('home.pybaq_label'),
      role: t('home.pybaq_role'),
      since: t('home.pybaq_since'),
      description: t('home.pybaq_desc'),
      url: pybaqUrl,
      cta: t('home.pybaq_cta')
    }}
  />
</BaseLayout>

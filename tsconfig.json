{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**"]
}

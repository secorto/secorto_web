{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/step/src/**/*",
    "packages/step/tests/**/*",
    "apps/web/src/**/*",
    "apps/web/tests/**/*"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**"]
}

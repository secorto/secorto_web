{
  "name": "@secorto/step",
  "version": "0.1.0",
  "private": false,
  "sideEffects": false,
  "description": "Framework-agnostic step primitive",
  "keywords": [
    "steps",
    "playwright",
    "testing"
  ],
  "homepage": "https://github.com/secorto/secorto_web/blob/master/packages/step#readme",
  "bugs": {
    "url": "https://github.com/secorto/secorto_web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secorto/secorto_web.git"
  },
  "license": "MIT",
  "author": "Sergio Carlos Orozco Torres",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "tsdown": {
    "entry": [
      "src/index.ts"
    ]
  }
}

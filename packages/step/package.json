{
  "name": "@secorto/step",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./playwright": {
      "types": "./src/playwright.ts",
      "import": "./dist/playwright.mjs",
      "default": "./dist/playwright.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/playwright.ts"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
